rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function googleUser() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function permission() {
      return get(/databases/$(database)/documents/accessRoles/$(request.auth.uid)).data;
    }
    function hasRole(role) {
      return googleUser()
        && exists(/databases/$(database)/documents/accessRoles/$(request.auth.uid))
        && permission().get('enabled', false) == true
        && permission().get('role', '') == role;
    }
    function isAdmin() { return hasRole('admin'); }
    function isRoute() { return isAdmin() || hasRole('route'); }
    function isSocio(profileId) {
      return isAdmin() || (hasRole('socio') && permission().get('profileId', '') == profileId);
    }
    function validGrant() {
      let d = request.resource.data;
      return d.keys().hasAll(['role', 'profileId', 'enabled'])
        && d.role in ['admin', 'route', 'socio']
        && d.enabled is bool
        && ((d.role in ['admin', 'route'] && d.profileId == '')
          || (d.role == 'socio' && d.profileId in ['tania', 'sofia', 'juan-pablo']));
    }
    function envelope(id) {
      return signedIn() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.data is map
        && request.resource.data.data.id == id;
    }
    function actor() { return request.resource.data.data.get('actorProfileId', ''); }
    function validContribution() {
      return (isRoute() && actor() == 'repartidor')
        || (actor() in ['tania', 'sofia', 'juan-pablo'] && isSocio(actor()));
    }
    function canReadContribution() {
      return isAdmin()
        || (hasRole('route') && resource.data.data.actorProfileId == 'repartidor')
        || (hasRole('socio') && resource.data.data.actorProfileId == permission().profileId);
    }
    function ownsRecord() { return signedIn() && resource.data.ownerUid == request.auth.uid; }
    function createsOwnRecord() {
      return signedIn() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.data is map;
    }
    function updatesOwnRecord() {
      return ownsRecord() && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.data is map;
    }

    // The first admin document is created manually in the Firebase console.
    // Requests and local PINs never grant permissions.
    match /accessRoles/{uid} {
      allow get: if (googleUser() && isOwner(uid)) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isAdmin() && uid != request.auth.uid && validGrant();
      allow delete: if isAdmin() && uid != request.auth.uid;
    }
    match /accessRequests/{uid} {
      allow read: if (googleUser() && isOwner(uid)) || isAdmin();
      allow create, update: if googleUser() && isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid','email','name','desiredRole','profileId','updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.desiredRole in ['admin','route','socio'];
      allow delete: if isAdmin();
    }
    match /routeClients/{id} {
      allow read: if isRoute();
      allow create, update: if isRoute() && envelope(id);
      allow delete: if isRoute();
    }
    match /routeContributions/{id} {
      allow read: if canReadContribution();
      allow create, update: if envelope(id) && validContribution();
      allow delete: if isAdmin();
    }
    match /socioProfiles/{profileId}/clients/{id} {
      allow read: if isSocio(profileId);
      allow create, update: if isSocio(profileId) && envelope(id) && actor() == profileId;
      allow delete: if isSocio(profileId);
    }
    match /socioProfiles/{profileId}/sales/{id} {
      allow read: if isSocio(profileId);
      allow create, update: if isSocio(profileId) && envelope(id) && actor() == profileId;
      allow delete: if isAdmin();
    }
    // Previous CRM identities keep access to their own records.
    match /users/{uid}/{collection}/{id} {
      allow read, write: if collection in ['clients','cuts','expenses','tasks']
        && (isOwner(uid) || isAdmin());
    }
    // Darkita keeps its existing anonymous device identity and PIN profiles.
    match /timeclockEmployees/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow create: if isOwner(uid) && createsOwnRecord();
      allow update: if isOwner(uid) && updatesOwnRecord();
      allow delete: if isOwner(uid);
    }
    match /timeclockRecords/{id} {
      allow read: if isAdmin() || ownsRecord();
      allow create: if createsOwnRecord();
      allow update: if updatesOwnRecord();
      allow delete: if ownsRecord();
    }
    match /timeclockWeeklyCuts/{id} {
      allow read: if isAdmin() || ownsRecord();
      allow create: if createsOwnRecord();
      allow update: if updatesOwnRecord();
      allow delete: if ownsRecord();
    }
    function nonnegativeCount(n) { return n is int && n >= 0 && n <= 100000; }
    function flavorCounts(v) { return v is list && v.size() == 5
      && nonnegativeCount(v[0]) && nonnegativeCount(v[1]) && nonnegativeCount(v[2])
      && nonnegativeCount(v[3]) && nonnegativeCount(v[4]); }
    function validProduction(id) {
      let d = request.resource.data.data;
      return d.id == id && d.employeeId is string && d.employeeName is string
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.piecesPerTray is int && d.piecesPerTray >= 1 && d.piecesPerTray <= 200
        && flavorCounts(d.trays) && flavorCounts(d.waste) && flavorCounts(d.seminar)
        && flavorCounts(d.trash) && flavorCounts(d.cookieInputs)
        && nonnegativeCount(d.cookiesDark) && nonnegativeCount(d.cookiesWhite)
        && d.createdAt is number && d.updatedAt is number && d.deleted is bool
        && d.note is string && d.note.size() <= 500;
    }
    match /productionRecords/{id} {
      allow read: if isAdmin() || ownsRecord();
      allow create: if createsOwnRecord() && validProduction(id);
      allow update: if updatesOwnRecord() && validProduction(id)
        && request.resource.data.data.employeeId == resource.data.data.employeeId
        && request.resource.data.data.createdAt == resource.data.data.createdAt;
      // Deletions are audited tombstones, retained for the administrator.
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
