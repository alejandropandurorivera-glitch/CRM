rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function googleUser() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function permission() {
      return get(/databases/$(database)/documents/accessRoles/$(request.auth.uid)).data;
    }
    function hasRole(role) {
      return googleUser()
        && exists(/databases/$(database)/documents/accessRoles/$(request.auth.uid))
        && permission().get('enabled', false) == true
        && permission().get('role', '') == role;
    }
    function isAdmin() { return hasRole('admin'); }
    function isRoute() { return isAdmin() || hasRole('route'); }
    function isSocio(profileId) {
      return isAdmin() || (hasRole('socio') && permission().get('profileId', '') == profileId);
    }
    function validGrant() {
      let d = request.resource.data;
      return d.keys().hasAll(['role', 'profileId', 'enabled'])
        && d.role in ['admin', 'route', 'socio']
        && d.enabled is bool
        && ((d.role in ['admin', 'route'] && d.profileId == '')
          || (d.role == 'socio' && d.profileId in ['tania', 'sofia', 'juan-pablo']));
    }
    function envelope(id) {
      return signedIn() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.data is map
        && request.resource.data.data.id == id;
    }
    function actor() { return request.resource.data.data.get('actorProfileId', ''); }
    function validContribution() {
      return (isRoute() && actor() == 'repartidor')
        || (actor() in ['tania', 'sofia', 'juan-pablo'] && isSocio(actor()));
    }
    function canReadContribution() {
      return isAdmin()
        || (hasRole('route') && resource.data.data.actorProfileId == 'repartidor')
        || (hasRole('socio') && resource.data.data.actorProfileId == permission().profileId);
    }
    function ownsRecord() { return signedIn() && resource.data.ownerUid == request.auth.uid; }
    function createsOwnRecord() {
      return signedIn() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.data is map;
    }
    function updatesOwnRecord() {
      return ownsRecord() && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.data is map;
    }

    // The first admin document is created manually in the Firebase console.
    // Requests and local PINs never grant permissions.
    match /accessRoles/{uid} {
      allow get: if (googleUser() && isOwner(uid)) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isAdmin() && uid != request.auth.uid && validGrant();
      allow delete: if isAdmin() && uid != request.auth.uid;
    }
    match /accessRequests/{uid} {
      allow read: if (googleUser() && isOwner(uid)) || isAdmin();
      allow create, update: if googleUser() && isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid','email','name','desiredRole','profileId','updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.desiredRole in ['admin','route','socio'];
      allow delete: if isAdmin();
    }
    match /routeSchedules/{id} {
      allow read: if isRoute();
      allow create, update: if isRoute() && envelope(id) && id == 'gdl'
        && request.resource.data.data.lastRouteDate is string
        && request.resource.data.data.lastRouteDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.data.intervalDays == 14
        && request.resource.data.data.closed is bool;
      allow delete: if isAdmin();
    }
    match /routeClients/{id} {
      allow read: if isRoute();
      allow create: if isRoute() && envelope(id);
      allow update: if isRoute() && envelope(id)
        && (!resource.data.data.get('deleted', false) || request.resource.data.data.get('deleted', false));
      allow delete: if isRoute();
    }
    match /routeExpenses/{id} {
      allow read: if isRoute();
      allow create, update: if isRoute() && envelope(id)
        && request.resource.data.data.amount is number && request.resource.data.data.amount > 0
        && request.resource.data.data.date is string && request.resource.data.data.concept is string;
      allow delete: if isAdmin();
    }
    match /routeContributions/{id} {
      allow read: if canReadContribution();
      allow create, update: if envelope(id) && validContribution();
      allow delete: if isAdmin();
    }
    match /socioProfiles/{profileId}/clients/{id} {
      allow read: if isSocio(profileId);
      allow create, update: if isSocio(profileId) && envelope(id) && actor() == profileId;
      allow delete: if isSocio(profileId);
    }
    match /socioProfiles/{profileId}/sales/{id} {
      allow read: if isSocio(profileId);
      allow create, update: if isSocio(profileId) && envelope(id) && actor() == profileId;
      allow delete: if isAdmin();
    }
    // Previous CRM identities keep access to their own records.
    match /users/{uid}/{collection}/{id} {
      allow read, write: if collection in ['clients','cuts','expenses','tasks']
        && (isOwner(uid) || isAdmin());
    }
    // Darkita keeps its existing anonymous device identity and PIN profiles.
    match /timeclockEmployees/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow create: if isOwner(uid) && createsOwnRecord();
      allow update: if isOwner(uid) && updatesOwnRecord();
      allow delete: if isOwner(uid);
    }
    match /timeclockRecords/{id} {
      allow read: if isAdmin() || ownsRecord();
      allow create: if createsOwnRecord();
      allow update: if updatesOwnRecord();
      allow delete: if ownsRecord();
    }
    match /timeclockWeeklyCuts/{id} {
      allow read: if isAdmin() || ownsRecord();
      allow create: if createsOwnRecord();
      allow update: if updatesOwnRecord();
      allow delete: if ownsRecord();
    }
    function nonnegativeCount(n) { return n is int && n >= 0 && n <= 100000; }
    function flavorCounts(v) { return v is list && v.size() == 5
      && nonnegativeCount(v[0]) && nonnegativeCount(v[1]) && nonnegativeCount(v[2])
      && nonnegativeCount(v[3]) && nonnegativeCount(v[4]); }
    function validProduction(id) {
      let d = request.resource.data.data;
      return d.id == id && d.employeeId is string && d.employeeName is string
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.piecesPerTray is int && d.piecesPerTray >= 1 && d.piecesPerTray <= 200
        && flavorCounts(d.trays) && flavorCounts(d.get('decorated',[0,0,0,0,0])) && flavorCounts(d.waste) && flavorCounts(d.seminar)
        && flavorCounts(d.trash) && flavorCounts(d.cookieInputs)
        && nonnegativeCount(d.cookiesDark) && nonnegativeCount(d.cookiesWhite)
        && d.createdAt is number && d.updatedAt is number && d.deleted is bool
        && d.note is string && d.note.size() <= 500
        && d.get('activityType','production') in ['production','decoration','sameDay','other']
        && d.get('otherActivity','') is string && d.get('otherActivity','').size() <= 180
        && (d.get('activityType','production') != 'other' || d.get('otherActivity','').size() > 0);
    }
    match /productionRecords/{id} {
      allow read: if isAdmin() || ownsRecord();
      allow create: if createsOwnRecord() && validProduction(id);
      allow update: if updatesOwnRecord() && validProduction(id)
        && request.resource.data.data.employeeId == resource.data.data.employeeId
        && request.resource.data.data.createdAt == resource.data.data.createdAt;
      // Deletions are audited tombstones, retained for the administrator.
      allow delete: if false;
    }
    function validCoverage(id) {
      let d = request.resource.data.data;
      return d.id == id && d.keys().hasOnly(['id','date','activityType','coverageStart','coverageEnd','coverageIntervals','createdAt','updatedAt','deleted','ownerUid'])
        && d.date is string && d.activityType in ['production','decoration','sameDay','other']
        && d.coverageIntervals is list && d.coverageIntervals.size() <= 20 && d.deleted is bool
        && existsAfter(/databases/$(database)/documents/productionRecords/$(id))
        && getAfter(/databases/$(database)/documents/productionRecords/$(id)).data.ownerUid == request.auth.uid;
    }
    match /productionCoverage/{id} {
      // Sólo intervalos y tipo de actividad, sin PIN, GPS, sueldos ni cantidades.
      allow read: if signedIn();
      allow create: if createsOwnRecord() && validCoverage(id);
      allow update: if updatesOwnRecord() && validCoverage(id);
      allow delete: if false;
    }
    function validPayrollRequest(id) {
      let d = request.resource.data.data;
      return createsOwnRecord() && id == request.auth.uid + '__' + d.id
        && d.ownerUid == request.auth.uid && d.status == 'pending'
        && d.employeeId is string && d.employeeName is string
        && d.rate == 50 && d.totalSeconds is int && d.totalSeconds > 0 && d.totalMinutes is number && d.totalMinutes > 0
        && d.amount is number && d.amount >= 0
        && d.allocations is list && d.allocations.size() > 0 && d.allocations.size() <= 20
        && d.createdAt is number && d.updatedAt is number;
    }
    function samePayrollSelection() {
      return request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.data.diff(resource.data.data).affectedKeys().hasOnly(['status','updatedAt','paymentId','paidAt']);
    }
    match /payrollRequests/{id} {
      allow get: if isAdmin() || ownsRecord() || (signedIn() && id.matches('^' + request.auth.uid + '__.*'));
      allow list: if isAdmin() || ownsRecord();
      allow create: if validPayrollRequest(id);
      allow update: if samePayrollSelection() && resource.data.data.status == 'pending'
        && ((isAdmin() && request.resource.data.data.status in ['paid','cancelled'])
          || (ownsRecord() && request.resource.data.data.status == 'cancelled'));
      allow delete: if false;
    }
    match /payrollPayments/{id} {
      allow read: if isAdmin() || ownsRecord();
      allow create: if isAdmin() && request.resource.data.data.id == id
        && request.resource.data.data.requestId == id
        && request.resource.data.ownerUid == request.resource.data.data.ownerUid
        && getAfter(/databases/$(database)/documents/payrollRequests/$(request.resource.data.ownerUid + '__' + id)).data.data.status == 'paid'
        && getAfter(/databases/$(database)/documents/payrollRequests/$(request.resource.data.ownerUid + '__' + id)).data.data.totalSeconds == request.resource.data.data.totalSeconds
        && getAfter(/databases/$(database)/documents/payrollRequests/$(request.resource.data.ownerUid + '__' + id)).data.data.amount == request.resource.data.data.amount;
      allow update, delete: if false;
    }
    match /payrollClaims/{id} {
      // Consulta exacta por ID de entrada; permite conservar abonos al recuperar una identidad.
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create, update: if isAdmin() && request.resource.data.data.id == id
        && request.resource.data.data.paidSeconds is int && request.resource.data.data.paidSeconds >= 0
        && request.resource.data.data.capacitySeconds is int
        && request.resource.data.data.paidSeconds <= request.resource.data.data.capacitySeconds;
      allow delete: if false;
    }
    function inventoryUser() { return signedIn() && (request.auth.token.firebase.sign_in_provider == 'anonymous' || isRoute()); }
    function quantities(a, negative) {
      return a is list && a.size() == 7
        && a[0] is int && a[0] >= (negative ? -100000 : 0) && a[0] <= 100000
        && a[1] is int && a[1] >= (negative ? -100000 : 0) && a[1] <= 100000
        && a[2] is int && a[2] >= (negative ? -100000 : 0) && a[2] <= 100000
        && a[3] is int && a[3] >= (negative ? -100000 : 0) && a[3] <= 100000
        && a[4] is int && a[4] >= (negative ? -100000 : 0) && a[4] <= 100000
        && a[5] is int && a[5] >= (negative ? -100000 : 0) && a[5] <= 100000
        && a[6] is int && a[6] >= (negative ? -100000 : 0) && a[6] <= 100000
        ;
    }
    function stockBefore() {
      return exists(/databases/$(database)/documents/inventoryBalances/main)
        ? get(/databases/$(database)/documents/inventoryBalances/main).data
        : {'factory':[0,0,0,0,0,0,0], 'car':[0,0,0,0,0,0,0], 'version':0};
    }
    function stockMath(a,b,d) {
      return quantities(a,false) && d is list && d.size() == 7
        && a[0] == b[0] + d[0]
        && a[1] == b[1] + d[1]
        && a[2] == b[2] + d[2]
        && a[3] == b[3] + d[3]
        && a[4] == b[4] + d[4]
        && a[5] == b[5] + d[5]
        && a[6] == b[6] + d[6]
        ;
    }
    function inventoryCommit(id,e,b,a) {
      return e.id == id && e.ownerUid == request.auth.uid
        && e.beforeVersion == b.version && e.afterVersion == a.version && a.version == b.version + 1
        && a.lastEventId == id && e.kind in ['source','add','count','load','unload','waste','withdraw']
        && e.detail is string && e.reason is string && e.reason.size() <= 400
        && (!(e.kind in ['count','waste']) || e.reason.size() > 0)
        && stockMath(a.factory,b.factory,e.delta.factory) && stockMath(a.car,b.car,e.delta.car);
    }
    match /inventoryBalances/{id} {
      allow read: if inventoryUser();
      allow create, update: if inventoryUser() && id == 'main'
        && inventoryCommit(request.resource.data.lastEventId,
          getAfter(/databases/$(database)/documents/inventoryEvents/$(request.resource.data.lastEventId)).data,
          stockBefore(), request.resource.data);
      allow delete: if false;
    }
    match /inventoryEvents/{id} {
      allow read: if inventoryUser();
      allow create: if inventoryUser() && inventoryCommit(id,request.resource.data,stockBefore(),
          getAfter(/databases/$(database)/documents/inventoryBalances/main).data)
        && (request.resource.data.kind != 'withdraw' ||
          getAfter(/databases/$(database)/documents/employeeWithdrawals/$(id)).data.ownerUid == request.auth.uid);
      allow update, delete: if false;
    }
    match /inventorySources/{id} {
      allow read: if inventoryUser();
      allow create, update: if inventoryUser()
        && ((!exists(/databases/$(database)/documents/inventorySources/$(id)) && request.resource.data.ownerUid == request.auth.uid)
          || (exists(/databases/$(database)/documents/inventorySources/$(id)) && (ownsRecord() || isAdmin()) && request.resource.data.ownerUid == resource.data.ownerUid))
        && quantities(request.resource.data.effect.factory,true) && quantities(request.resource.data.effect.car,true)
        && request.resource.data.revision is number
        && (!exists(/databases/$(database)/documents/inventorySources/$(id)) || request.resource.data.revision > resource.data.revision)
        && getAfter(/databases/$(database)/documents/inventoryEvents/$(request.resource.data.lastEventId)).data.sourceId == id;
      allow delete: if false;
    }
    match /employeeWithdrawals/{id} {
      allow read: if isAdmin() || ownsRecord();
      allow create: if inventoryUser() && createsOwnRecord()
        && request.resource.data.data.id == id && request.resource.data.data.ownerUid == request.auth.uid
        && quantities(request.resource.data.data.quantities,false)
        && request.resource.data.data.pieces == request.resource.data.data.quantities[0] + request.resource.data.data.quantities[1] + request.resource.data.data.quantities[2] + request.resource.data.data.quantities[3] + request.resource.data.data.quantities[4] + request.resource.data.data.quantities[5] + request.resource.data.data.quantities[6]
        && request.resource.data.data.unitPrice == 19
        && request.resource.data.data.otherCents is int && request.resource.data.data.otherCents >= 0
        && request.resource.data.data.amountCents == request.resource.data.data.pieces * 1900 + request.resource.data.data.otherCents
        && request.resource.data.data.amountCents > 0
        && (request.resource.data.data.otherCents == 0 || request.resource.data.data.otherConcept.size() > 0)
        && getAfter(/databases/$(database)/documents/inventoryEvents/$(id)).data.kind == 'withdraw'
        && getAfter(/databases/$(database)/documents/inventoryEvents/$(id)).data.ownerUid == request.auth.uid;
      allow update, delete: if false;
    }
    match /payrollDeductionClaims/{id} {
      allow read: if isAdmin() || ownsRecord();
      allow create, update: if isAdmin()
        && request.resource.data.ownerUid == get(/databases/$(database)/documents/employeeWithdrawals/$(id)).data.ownerUid
        && request.resource.data.data.paidCents is int && request.resource.data.data.paidCents >= 0
        && request.resource.data.data.paidCents <= get(/databases/$(database)/documents/employeeWithdrawals/$(id)).data.data.amountCents
        && (!exists(/databases/$(database)/documents/payrollDeductionClaims/$(id)) || request.resource.data.data.paidCents >= resource.data.data.paidCents);
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
