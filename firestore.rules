rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.uid == 'darkis-admin'
        && request.auth.token.get('role', '') == 'admin';
    }

    function isRoute() {
      return signedIn()
        && request.auth.uid == 'darkis-route'
        && request.auth.token.get('role', '') == 'route'
        && request.auth.token.get('profileId', '') == 'repartidor';
    }

    function isSocio(profileId) {
      return signedIn()
        && request.auth.uid == 'darkis-socio-' + profileId
        && request.auth.token.get('role', '') == 'socio'
        && request.auth.token.get('profileId', '') == profileId;
    }

    function isSocioCaller() {
      return signedIn()
        && request.auth.token.get('role', '') == 'socio'
        && request.auth.token.get('profileId', '') in ['tania', 'sofia', 'juan-pablo']
        && request.auth.uid == 'darkis-socio-'
          + request.auth.token.get('profileId', '');
    }

    function actorOfWrite() {
      return request.resource.data.get('data', {}).get('actorProfileId', '');
    }

    function hasOwnSocioActor() {
      return actorOfWrite() == request.auth.token.get('profileId', '');
    }

    function hasRouteActor() {
      return actorOfWrite() == 'repartidor';
    }

    function ownsRecord() {
      return signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    function createsOwnRecord() {
      return signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.data is map;
    }

    function updatesOwnRecord() {
      return ownsRecord()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.data is map;
    }

    // Existing CRM records. The administrator may read data belonging to
    // an earlier email/password UID during migration.
    match /users/{uid}/clients/{id} {
      allow read, write: if isOwner(uid) || isAdmin();
    }
    match /users/{uid}/cuts/{id} {
      allow read, write: if isOwner(uid) || isAdmin();
    }
    match /users/{uid}/expenses/{id} {
      allow read, write: if isOwner(uid) || isAdmin();
    }
    match /users/{uid}/tasks/{id} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    // The courier's customer book is separate from the administrator's CRM.
    match /routeClients/{clientId} {
      allow read: if isAdmin() || (isRoute() && ownsRecord());
      allow create: if isRoute() && createsOwnRecord();
      allow update: if isRoute() && updatesOwnRecord();
      allow delete: if isRoute() && ownsRecord();
    }

    // Contributions made by couriers and socios feed administrator reporting.
    // Socios may only attribute records to their own authenticated profile.
    match /routeContributions/{contributionId} {
      allow read: if isAdmin()
        || ((isRoute() || isSocioCaller()) && ownsRecord());
      allow create: if ((isRoute() && hasRouteActor())
        || (isSocioCaller() && hasOwnSocioActor()))
        && createsOwnRecord();
      allow update: if ((isRoute() && hasRouteActor())
        || (isSocioCaller() && hasOwnSocioActor()))
        && updatesOwnRecord();
      allow delete: if (isRoute() || isSocioCaller()) && ownsRecord();
    }

    // A Darkisocio identity can access only its own clients and sales.
    // The administrator can review all profiles without impersonating them.
    match /socioProfiles/{profileId}/clients/{clientId} {
      allow read: if isAdmin() || (isSocio(profileId) && ownsRecord());
      allow create: if isSocio(profileId) && createsOwnRecord();
      allow update: if isSocio(profileId) && updatesOwnRecord();
      allow delete: if isSocio(profileId) && ownsRecord();
    }
    match /socioProfiles/{profileId}/sales/{saleId} {
      allow read: if isAdmin() || (isSocio(profileId) && ownsRecord());
      allow create: if isSocio(profileId) && createsOwnRecord();
      allow update: if isSocio(profileId) && updatesOwnRecord();
      allow delete: if isSocio(profileId) && ownsRecord();
    }

    // Legacy employee-clock accounts remain anonymous per device.
    match /timeclockEmployees/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow create: if isOwner(uid) && createsOwnRecord();
      allow update: if isOwner(uid) && updatesOwnRecord();
      allow delete: if isOwner(uid);
    }
    match /timeclockRecords/{recordId} {
      allow read: if isAdmin() || ownsRecord();
      allow create: if createsOwnRecord();
      allow update: if updatesOwnRecord();
      allow delete: if ownsRecord();
    }
    match /timeclockWeeklyCuts/{cutId} {
      allow read: if isAdmin() || ownsRecord();
      allow create: if createsOwnRecord();
      allow update: if updatesOwnRecord();
      allow delete: if ownsRecord();
    }

    // Includes private rate-limit counters under _pinAttempts.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
